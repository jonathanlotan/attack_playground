# the host ports the playground publishes - the one place they are set.
#
# docker compose reads this file on its own and substitutes the values into
# docker-compose.yaml. scripts/common.sh loads it (load_ports) so start.sh and
# the verify scripts wait on, print and probe the same numbers, and start.sh
# hands SSH_PORT to the networking script that keys the ssh connection cap on
# it. change a port here and nowhere else.

# containerssh, the port guests ssh into. published on every address.
SSH_PORT=2222

# the auth webhook and the connection statistics. published on 127.0.0.1 only -
# see the ports comments in docker-compose.yaml for why.
AUTH_PORT=2223
STATS_PORT=2224
